# Crawler pipeline configuration
# URL to crawl if not provided via CLI arg
CRAWL_URL=https://column.etnetchina.cn/list/article-latest

# Maximum number of articles to discover per run
MAX_ARTICLES=50

# Semantic similarity threshold (0.0 - 1.0)
SEMANTIC_THRESHOLD=0.35

# Optional: Proxy rotation (comma-separated list)
# PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port
# PROXY_ROTATION=per_request  # or per_domain
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Playwright/browser behavior
# HEADLESS=true
# MAX_RENDER_MS=20000

# Target keywords (comma list or JSON array)
# Example (JSON array recommended to preserve spaces/Unicode):
KEYWORDS=[中國,財經,經濟,金融,投資,股市,港股,A股,人民幣,央行,政策,貿易,出口,進口,GDP,通脹,房地產,科技,互聯網,人工智能,新能源,環保]
