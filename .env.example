# Proxies (optional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ScrapeGraphAI LLM provider config (pick one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Or set SCRAPEGRAPH_MODEL, e.g., gpt-4o-mini / llama-3.1-70b / claude-3.5-sonnet
SCRAPEGRAPH_MODEL=gpt-4o-mini

# Operational tweaks
BROWSER_POOL=2
REQUEST_TIMEOUT_SECS=30
MAX_RENDER_MS=15000
PER_DOMAIN_QPS=0.5
