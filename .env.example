# Optional authentication for HTTP endpoints. Set this outside local-only use.
OMNISCRAPE_API_KEY=
# Required with a non-loopback `serve --host`; comma-separated exact authorities.
OMNISCRAPE_ALLOWED_HOSTS=localhost,127.0.0.1

# Outbound fetch and queue limits
# Valid range: 1-32. The same limit governs extraction, body-reader, fetch,
# provider, and cleanup admission.
OMNISCRAPE_MAX_CONCURRENCY=8
OMNISCRAPE_QUEUE_TIMEOUT_SECONDS=5
OMNISCRAPE_REQUEST_BODY_TIMEOUT_SECONDS=5
OMNISCRAPE_CONNECT_TIMEOUT_SECONDS=5
OMNISCRAPE_READ_TIMEOUT_SECONDS=15
OMNISCRAPE_FETCH_TIMEOUT_SECONDS=30
OMNISCRAPE_MAX_RESPONSE_BYTES=2000000
OMNISCRAPE_MAX_REDIRECTS=5
OMNISCRAPE_USER_AGENT=OmniScrape/0.2 (+https://github.com/Z-MarkUs/OmniScrape)

# Optional browser rendering (`pip install -e ".[browser]"`). HTTP API rendering
# is off by default. Enable it only for trusted, explicitly authorized targets in
# an OS/container with external CPU and memory limits.
OMNISCRAPE_ENABLE_API_RENDERING=false
# Strict valid range: 1-2.
OMNISCRAPE_MAX_RENDER_CONCURRENCY=2
OMNISCRAPE_RENDER_TIMEOUT_MS=15000
OMNISCRAPE_MAX_RENDER_REQUESTS=128
OMNISCRAPE_MAX_RENDER_NODES=50000

# Optional, lazily loaded LLM fallback for explicit `auto` or `llm` mode
# (`pip install -e ".[llm]"`)
OPENAI_API_KEY=
OMNISCRAPE_OPENAI_MODEL=gpt-5.6-luna
OMNISCRAPE_PROVIDER_TIMEOUT_SECONDS=30
OMNISCRAPE_AUTO_LLM_THRESHOLD=0.72
